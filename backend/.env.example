# Copy to backend/.env and replace credential placeholders locally.
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASS=your_mysql_password
DB_NAME=labadahub
JWT_SECRET=replace_with_a_long_random_secret

PORT=5000
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=labadahub7@gmail.com
SMTP_PASS=your_google_app_password
SMTP_FROM=LabadaHub <labadahub7@gmail.com>

FIRST_ADMIN_EMAIL=justinaceejay08@gmail.com
ADMIN_APPLICATION_APPROVER_EMAIL=labadahub7@gmail.com
PUBLIC_API_BASE_URL=https://your-public-api-host/api/v1
# Configure a Google OAuth Web client and register this exact HTTPS callback URI.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-public-api-host/api/v1/auth/admin-applications/oauth/callback
# Use at least 32 cryptographically random bytes; do not reuse JWT_SECRET.
ADMIN_APPLICATION_SECURITY_SECRET=
